# Copy to `.env` in this folder (mobile/) and restart `npx expo start`.
#
# Same value as web frontend NEXT_PUBLIC_API_URL — include /api or use host only (auto-normalized).
# Examples:
#   EXPO_PUBLIC_API_URL=http://10.0.2.2:4000/api
#   EXPO_PUBLIC_API_URL=http://192.168.1.10:4000/api
#
# - Android emulator: 10.0.2.2 = your PC's localhost
# - iOS simulator: http://127.0.0.1:4000/api often works
# - Physical Android: set EXPO_PUBLIC_API_URL to http://<PC-LAN-IP>:4000/api, then rebuild a dev
#   client (`npx expo run:android`) so usesCleartextTraffic applies — stock Expo Go cannot change that.
EXPO_PUBLIC_API_URL=

# Optional: FunDogs site URL for “Donate in browser”, Support, Terms, etc. (no trailing slash)
EXPO_PUBLIC_WEB_ORIGIN=
