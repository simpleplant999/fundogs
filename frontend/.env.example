# Same-origin App Router API (default). Set to Nest while migrating, e.g. http://localhost:4000/api
NEXT_PUBLIC_API_URL=/api

# MongoDB — Atlas connection string (or local mongodb://127.0.0.1:27017/fundogs)
# Prisma requires a DB name after the host: ...mongodb.net/fundogs?...
# Do not wrap the whole URL in extra quotes inside the value.
# Vercel: also set this in Production env vars. Atlas Network Access must allow 0.0.0.0/0
# (serverless IPs are not a single range).
DATABASE_URL=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/fundogs?retryWrites=true&w=majority

JWT_SECRET=change-this-to-a-long-random-string-in-production

ADMIN_EMAIL=admin@fundogs.local
ADMIN_PASSWORD=admin123
ADMIN_NAME=Site Admin

# Must be the Publishable key from Dashboard → Developers → API keys (pk_test_…).
NEXT_PUBLIC_PAYMONGO_PUBLIC_KEY=

# Stripe publishable key (pk_...) — required for in-page card form (Payment Element).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Payment secrets (server-only; required when payment routes are ported)
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
